  "護理師": {
    "new_word": [
      {
        "fm_word": "kangguhu",
        "dialect": "南王"
      }
    ],
    "sentence": [
      {
        "fm_sentence": "a kanguhu tu kiyakarunan kan baelri na babayan.",
        "ch_sentence": "我姊姊是位護理師。",
        "dialect": "南王"
      },
      {
        "fm_sentence": "a kanguhu tu kiyakarunan ni ivalri na vavayan.",
        "ch_sentence": "我姊姊是位護理師。",
        "dialect": "初鹿"
      },
      {
        "fm_sentence": "i valri na vavayan maw na kanguhu i malri.",
        "ch_sentence": "我姊姊是醫院的護士。",
        "dialect": "知本"
      },
      {
        "fm_sentence": "maremu na kanguhu i biyoing kema i malri.",
        "ch_sentence": "爸爸說：醫院的護士很兇！",
        "dialect": "建和"
      }
    ],
    "source_year": "108"
  }
