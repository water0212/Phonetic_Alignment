  "戶籍謄本": {
    "new_word": [
      {
        "fm_word": [
          "hucitengpen"
        ],
        "ch_semantic": "(音譯詞)",
        "dialect": []
      }
    ],
    "sentence": [
      {
        "fm_sentence": "idri na ngai na \"hu-ci teng-pen\" i, a tinaraminkuk. uniyan ta kangaiyan na tinarapuyuma. driyama, ta kibulasaw tu ngai dra Minkuk.",
        "ch_sentence": "這個「hu-ci teng-pen」是中文說法，沒有卑南族語的說法，所以借用了中文。",
        "dialect": "南王"
      },
      {
        "fm_sentence": "mukuwa ta puvalraya kana puwasatayan mu, murung ta za hu-ci teng-pen.",
        "ch_sentence": "要申報納稅時要帶戶籍謄本。",
        "dialect": "初鹿"
      },
      {
        "fm_sentence": "temaraminkuk marengay kana hu-ci teng-pen.",
        "ch_sentence": "用國語說出戶籍謄本。",
        "dialect": "知本"
      },
      {
        "fm_sentence": "kusikitohung kema kana hu-ci teng-pen.",
        "ch_sentence": "用國語說出戶籍謄本。",
        "dialect": "建和"
      }
    ],
    "source_year": "106"
  },
